Host saltbox-sshfs
  User '{{ pillar.get('sshfs_user', 'saltbox') }}'
  Hostname '{{ pillar.get('sshfs_server', 'sshfs') }}'
  PasswordAuthentication no
  StrictHostKeyChecking no
  Port {{ pillar.get('sshfs_port', 1022) }}
  IdentityFile '{{ pillar.get('sshfs_privkey', '/root/.ssh/saltbox_ed25519') }}'
